# Mac track files (ignore)
.DS_Store
*.tmp
*.swp
*.swo

# opencode local dependencies
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock
.env

# Python
__pycache__/
*.pyc
.venv/

# Renoise
*.xrns.bak
*.xrns.tmp

# state (runtime, not committed)
host/state/*
!host/state/session.example.json
host/osc/sent/*
host/osc/outbox/*

# logs
tools/AIDJ/logs/*
*.log

# generated content
tools/AIDJ/generated/*
*.xrns
